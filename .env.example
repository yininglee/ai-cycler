# 只用于开发环境。复制为 .env.local 后填写，不要提交真实 Token。
AI_ANALYSIS_ENABLED=false
# Auth defaults to the local, signed development session. The OIDC adapter is
# intentionally unavailable until a provider, callback and server-side token
# validation are configured; setting this to oidc blocks local-session use.
AUTH_SESSION_MODE=development
SESSION_SECRET=
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# 首轮真实联调保持false；只有优化样例并建立同条件对照实验后才开启。
AI_FEW_SHOT_ENABLED=false
COZE_API_URL=https://api.coze.cn/v1/workflow/run
COZE_API_TOKEN=
COZE_MODEL_ID=
COZE_INTERPRETATION_WORKFLOW_NAME=ride_analysis_v3
COZE_INTERPRETATION_WORKFLOW_ID=
COZE_INTERPRETATION_WORKFLOW_VERSION=v0.0.8
COZE_INTERPRETATION_MODEL_ID=
AI_ANALYSIS_TIMEOUT_MS=25000
AI_MAX_RESPONSE_BYTES=262144
# MVP-FOUNDATION-04：导入限流（进程内滑动窗口，默认 10 次 / 60 秒）。
# IMPORT_RATE_LIMIT_MAX=10
# IMPORT_RATE_LIMIT_WINDOW_MS=60000

# M3 Chat 与骑后解读完全隔离。先在扣子创建独立 Workflow，再复制为 .env.local 填写。
# 真实调用还需要 CHAT_MODEL_ENABLED=true；chat_enabled 仍须独立通过 Gate 后才可开放。
CHAT_MODEL_ENABLED=false
CHAT_PROVIDER_KIND=coze_workflow
COZE_CHAT_API_URL=https://api.coze.cn/v1/workflow/run
COZE_CHAT_WORKFLOW_NAME=ride_chat_v1
COZE_CHAT_WORKFLOW_ID=
COZE_CHAT_WORKFLOW_VERSION=v0.1.0
COZE_CHAT_API_TOKEN=
COZE_CHAT_MODEL_ID=
COZE_CHAT_TIMEOUT_MS=8000
COZE_CHAT_MAX_RESPONSE_BYTES=65536

# CHAT-12 P2：L1 意图分类器影子模式（只记录分类日志，不影响路由与回复）。
# 独立开关，不依赖 CHAT_MODEL_ENABLED；URL/Token/模型默认复用上方 COZE_CHAT_*（同一扣子账号），
# 可用 COZE_CHAT_CLASSIFIER_API_URL / _API_TOKEN / _MODEL_ID 覆盖；绝不读取骑后解读的 COZE_* 配置。
# 启用需在扣子创建 ride_chat_classifier_v1 Workflow（Prompt 见 prompts/ride-chat-classifier-v0.1.md），
# 填写 WORKFLOW_ID / WORKFLOW_VERSION 两项后置 CHAT_CLASSIFIER_ENABLED=true。
CHAT_CLASSIFIER_ENABLED=false
COZE_CHAT_CLASSIFIER_WORKFLOW_NAME=ride_chat_classifier_v1
COZE_CHAT_CLASSIFIER_WORKFLOW_ID=
COZE_CHAT_CLASSIFIER_WORKFLOW_VERSION=v0.1.0
# COZE_CHAT_CLASSIFIER_TIMEOUT_MS=5000
# COZE_CHAT_CLASSIFIER_MAX_RESPONSE_BYTES=16384
# CHAT-12 P3：分类器运行模式——shadow（默认，只记录不生效）或 active（接管主路由：
# L0 快路径直答，未命中交 L1 语义分类器，失败/超时/限流降级 P1 规则保底）。
# 影子准确率达标（≥95% 且 red-team 零失误）并经用户确认后才可切 active。
CHAT_CLASSIFIER_MODE=shadow

# ---------------------------------------------------------------------------
# 会话 cookie 的 Secure 标记
# ---------------------------------------------------------------------------
# 默认行为：NODE_ENV=production 时给会话 cookie 加 Secure，开发环境不加。
# 本地用生产构建 + 局域网纯 HTTP 演示（如 http://192.168.31.62:3000）时，
# 浏览器会丢弃带 Secure 的 cookie，导致会话无法保持（聊天发不出、导入丢会话），
# 此时置为 0 可关闭 Secure。正式 HTTPS 部署请保持默认（不加本行或置为 1）。
# 可选值：1/true/yes（开启）｜0/false/off/no（关闭）
# SESSION_COOKIE_SECURE=0

# ---------------------------------------------------------------------------
# 演示模式：校验旁路（2026-10-14 用户决策，仅限 demo）
# ---------------------------------------------------------------------------
# 默认 off。置 on 后 V2 解读（?ai=v2）跳过校验拦截：首轮输出直接展示，
# 校验器仍运行并记录 issue（响应 v2Candidate.bypassedIssueCodes 可观测，
# 演示即失败率探针），但不做确定性收敛 / 模型修复 / 语义豁免 / 降级。
# 前端会显示"演示标注"角标。注意：
# - 校验门设计不变（validator/repair/语义豁免代码零改动），正式链路照旧；
# - 评测脚本（R03 / V21-12 盲评）永远不读此开关，旁路结论不给放量背书；
# - JSON 解析失败的首轮输出无法展示，仍走原链路。
# 可选值：on（开启）｜缺省或任意其他值 = off
# DEMO_VALIDATION_BYPASS=on
