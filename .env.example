# 只用于开发环境。复制为 .env.local 后填写，不要提交真实 Token。
# development 启用本地邮箱账号登录。oidc 预留给外部身份服务。
# 部署时设置独立随机值，长度至少 32 字符。更换后须重新连接行者。
AUTH_SESSION_MODE=development
SESSION_SECRET=
# 顽鹿 OTM 单账号联调，只在受控的单实例 Cycler 服务启用。
# SESSION_SECRET 至少 32 字符，以下凭据只放在服务端环境中。
ONELAP_SYNC_ENABLED=false
ONELAP_SYNC_OWNER_ID=
ONELAP_SYNC_ACCOUNT_ID=
ONELAP_SYNC_TOKEN=
ONELAP_SYNC_SIGNING_KEY=
# ONELAP_SYNC_COOKIE=
# 行者开放平台只读授权，回调地址需与开发者应用配置匹配。
XINGZHE_SYNC_ENABLED=false
XINGZHE_CLIENT_ID=
XINGZHE_CLIENT_SECRET=
XINGZHE_REDIRECT_URI=http://127.0.0.1:3000/api/platform/xingzhe/callback
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# MVP-FOUNDATION-04：导入限流（进程内滑动窗口，默认 10 次 / 60 秒）。
# IMPORT_RATE_LIMIT_MAX=10
# IMPORT_RATE_LIMIT_WINDOW_MS=60000

# 骑后解读、硅基流动主对话、边界分类器和首版训练计划共用服务端凭据。
SILICONFLOW_API_TOKEN=

# 主对话与首版训练计划生成。
CHAT_MODEL_ENABLED=false
CHAT_PROVIDER_KIND=siliconflow
# SILICONFLOW_CHAT_MODEL_ID=deepseek-ai/DeepSeek-V3.2
# 主对话也支持自建 HTTP 端点：CHAT_PROVIDER_KIND=http，
# 设置 CHAT_PROVIDER_URL、CHAT_PROVIDER_API_TOKEN、CHAT_PROVIDER_MODEL_ID。首次排期仍使用硅基流动。

# 边界分类器独立启用，使用同一硅基流动凭据；配置完成后分类结果直接参与路由。
CHAT_CLASSIFIER_ENABLED=false
# SILICONFLOW_CLASSIFIER_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash

# 骑后深度解读使用 V2。启用时设为 true，并填写上方的 SILICONFLOW_API_TOKEN。
AI_ANALYSIS_ENABLED=false
AI_ANALYSIS_TIMEOUT_MS=25000
AI_MAX_RESPONSE_BYTES=262144
# RIDE_MODEL_V2_MODEL_ID=deepseek-ai/DeepSeek-V4-Flash
# 语义复核默认复用解读主模型，可单独指定模型。
# RIDE_MODEL_V2_SEMANTIC_MODEL_ID=

# ---------------------------------------------------------------------------
# 会话 cookie 的 Secure 标记
# ---------------------------------------------------------------------------
# 默认行为：NODE_ENV=production 时给会话 cookie 加 Secure，开发环境不加。
# 本地用生产构建 + 局域网纯 HTTP 演示（如 http://192.168.31.62:3000）时，
# 浏览器会丢弃带 Secure 的 cookie，导致会话无法保持（聊天发不出、导入丢会话），
# 此时置为 0 可关闭 Secure。正式 HTTPS 部署请保持默认（不加本行或置为 1）。
# 可选值：1/true/yes（开启）｜0/false/off/no（关闭）
# SESSION_COOKIE_SECURE=0

# ---------------------------------------------------------------------------
# 演示模式：校验旁路（2026-10-14 用户决策，仅限 demo）
# ---------------------------------------------------------------------------
# 默认 off。置 on 后 V2 解读跳过校验拦截：首轮输出直接展示，
# 校验器仍运行并记录 issue（响应 v2Candidate.bypassedIssueCodes 可观测，
# 演示即失败率探针），但不做确定性收敛 / 模型修复 / 语义豁免 / 降级。
# 前端会显示"演示标注"角标。注意：
# - 校验门设计不变（validator/repair/语义豁免代码零改动），正式链路照旧；
# - 评测脚本（R03 / V21-12 盲评）永远不读此开关，旁路结论不给放量背书；
# - JSON 解析失败的首轮输出无法展示，仍走原链路。
# 可选值：on（开启）｜缺省或任意其他值 = off
# DEMO_VALIDATION_BYPASS=on
