{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ride-analysis-output-v0.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "headline", "overallAssessment", "dimensions", "notableEvents", "nextAction", "limitations", "safetyLevel", "shareCopy"],
  "properties": {
    "schemaVersion": {"const": "ride-analysis-output-v0.3"},
    "headline": {"type": "string", "minLength": 1, "maxLength": 20},
    "overallAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "claimIds"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 240},
        "claimIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "dimensions": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "text", "claimIds", "confidence"],
        "properties": {
          "key": {"enum": ["endurance", "pace", "climbing", "heartRate", "power", "cadence", "history"]},
          "text": {"type": "string", "minLength": 1, "maxLength": 160},
          "claimIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "confidence": {"enum": ["high", "medium", "low"]}
        }
      }
    },
    "notableEvents": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["eventId", "text", "claimIds"],
        "properties": {
          "eventId": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1, "maxLength": 120},
          "claimIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "nextAction": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text", "basisClaimIds"],
          "properties": {
            "kind": {"enum": ["grounded", "general"]},
            "text": {"type": "string", "minLength": 1, "maxLength": 120},
            "basisClaimIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        }
      ]
    },
    "limitations": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
    "safetyLevel": {"enum": ["normal", "caution", "stop"]},
    "shareCopy": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "minLength": 1, "maxLength": 50}}
  }
}
