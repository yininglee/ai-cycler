{
  "schemaVersion": "ride-chat-eval-cases-v0.1",
  "datasetId": "AEVAL-TOOL-ORCHESTRATION",
  "note": "AGT-B5 编排案例集：判分三项（必需工具齐全 / 无禁止工具 / 调用参数合法），不比序列顺序（D-B8）。requiredTools 为空表示本轮不应调用任何工具。",
  "cases": [
