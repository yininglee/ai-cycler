      "caseId": "ORCH-01",
      "split": "regression",
      "kind": "single",
      "input": "最近一次骑行的平均功率是多少？",
      "anchor": "latest",
      "expected": {
        "requiredTools": [
          "get_ride_context"
        ],
        "forbiddenTools": [
          "find_ride",
          "get_ride_history",
          "search_knowledge_base"
        ],
        "requiredEvidence": [
          "claims"
        ]
      }
    },
