  "knowledge": [
    {
      "knowledgeId": "kb-b1-tss",
      "citation": "Glossary of TrainingPeaks Metrics — Training Stress Score — TrainingPeaks (accessed 2026-10-05), https://trainingpeaks.com/learn/articles/glossary-of-trainingpeaks-metrics/",
      "explanation": "训练压力分数（TSS，Training Stress Score）以“一小时恰好按 FTP 骑行 = 100 分”为基准，把一次骑行的时长与强度（归一化功率与强度系数）折算成单一数字。通常单次 <150 为轻度负荷、150-300 为中度、>300 后恢复需求显著上升。该数字只用于解释负荷量级，用户当次实际 TSS 须以骑行记录计算结果为准。",
      "conditions": [
        "功率数据完整的骑行记录",
        "已具备可信 FTP 基准",
        "strength:high"
      ],
      "conclusionStrength": "high",
      "limitations": [
        "TSS 是模型估算而非生理测量",
        "数值含义依赖 FTP 基准的准确性"
      ],
      "safetyBoundaries": [],
      "forbiddenFactKeys": [
        "trainingLoad.tss",
        "power.np",
        "power.if",
        "power.mean"
      ],
      "knowledgeBaseVersion": "ride-kb-batch1-1.0.0",
      "retrievedAt": "2026-10-05T06:00:00.000Z"
    },
    {
      "knowledgeId": "kb-b1-ftp",
      "citation": "Thresholds 411 & Glossary of TrainingPeaks Metrics — Functional Threshold Power — TrainingPeaks (accessed 2026-10-05), https://www.trainingpeaks.com/learn/articles/thresholds-411/ 及术语表条目",
      "explanation": "功能性阈值功率（FTP）指骑手约一小时时间内可持续维持的最高功率，是功率区间与负荷计算的锚点。常见测试协议包括 60 分钟全力或 20 分钟平均功率×0.95。知识只解释概念与测试方法；用户当前采用的 FTP 数值属于个人骑行事实，只能来自已验证的记录。",
      "conditions": [
        "功率数据完整的骑行记录",
        "解读涉及强度区间或负荷计算时",
        "strength:high"
      ],
      "conclusionStrength": "high",
      "limitations": [
        "20 分钟×0.95 为常用估算协议，个体误差可达数个百分点",
        "FTP 随训练状态变化需定期复测"
      ],
      "safetyBoundaries": [],
      "forbiddenFactKeys": [
        "power.ftp",
        "verifiedFtp",
        "power.peak20",
        "power.mean"
      ],
      "knowledgeBaseVersion": "ride-kb-batch1-1.0.0",
      "retrievedAt": "2026-10-05T06:00:00.000Z"
    },
    {
      "knowledgeId": "kb-b1-power-zones",
      "citation": "Power Training Levels — Dr. Andrew Coggan — TrainingPeaks (2016（作者原文首发）), https://www.trainingpeaks.com/blog/power-training-levels/",
      "explanation": "Coggan 七级功率区间以 FTP 为锚：Z1 主动恢复（<55% FTP）、Z2 耐力（56-75%）、Z3 节奏（76-90%）、Z4 阈值（91-105%）、Z5 VO₂max（106-120%）、Z6 无氧能力（121-150%）、Z7 神经肌功率（>150%）。解读功率分布时通常关注 Z2 占比（有氧基础）与 Z4 以上占比（高强度刺激），用户当次落在各区间的时间占比属于骑行事实。",
      "conditions": [
        "已具备 FTP 基准",
        "功率数据完整",
        "strength:high"
      ],
      "conclusionStrength": "high",
      "limitations": [
        "区间边界为百分比近似，个体生理转折点存在差异"
      ],
      "safetyBoundaries": [],
      "forbiddenFactKeys": [
        "power.zones",
        "power.ftp",
        "power.mean"
      ],
      "knowledgeBaseVersion": "ride-kb-batch1-1.0.0",
      "retrievedAt": "2026-10-05T06:00:00.000Z"
    }
